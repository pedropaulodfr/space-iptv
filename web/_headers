# Headers de seguranca dos arquivos estaticos do Space IPTV.
# O HTML autenticado (/, /index.html) passa pela Function e recebe os mesmos
# headers pelo middleware (functions/_middleware.js).
# Mantenha a CSP igual a constante CSP de functions/_lib/http.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Content-Security-Policy: default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self'; img-src 'self' data: blob: https: http:; font-src 'self'; connect-src 'self' blob: data: https: http:; media-src 'self' blob: data: https: http:; worker-src 'self' blob:
