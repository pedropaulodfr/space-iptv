<?xml version="1.0" encoding="utf-8"?>
<!--
  Superficie de video usada pelos slots do ExoPlayer.

  surface_type="texture_view" e obrigatorio: com SurfaceView o video e composto numa
  camada propria do sistema e, numa janela translucida (a nossa, durante a reproducao),
  ele passa a ser desenhado POR CIMA da WebView - os controles, o titulo e a barra de
  progresso ficam escondidos atras do video. Com TextureView o video e apenas mais uma
  View da hierarquia, entao a WebView (que vem depois, no FrameLayout) desenha sempre
  por cima dele.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false"
    app:resize_mode="fit"
    app:show_buffering="never"
    app:shutter_background_color="@android:color/transparent" />
